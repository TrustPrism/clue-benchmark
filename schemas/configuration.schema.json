          "type": "integer"
        },
        "max_solver_calls": {
          "type": "integer"
        },
        "output_directory": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "splits": {
          "type": "object"
        },
        "workers": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "distribution": {
