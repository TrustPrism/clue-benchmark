            "min_pairwise_clues": {
              "type": "integer"
            },
            "min_unique_subset_size": {
              "type": "integer"
            },
            "mutation_steps": {
              "type": "integer"
            },
            "reasoning_route": {
              "type": "string"
            },
            "require_indirect_essential": {
              "type": "boolean"
            },
            "solver_seconds": {
              "type": "number"
            },
            "solver_work": {
              "type": "number"
            },
            "suspect_count": {
              "type": "integer"
            }
