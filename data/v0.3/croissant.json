  "@type": "sc:Dataset",
  "name": "Clue Benchmark v0.3 private preview",
  "version": "0.3.0",
  "description": "960 paired synthetic mystery cases from 480 solver-verified worlds, with deduction and budgeted investigation tracks. Private preview; licensing pending.",
  "url": "https://github.com/TrustPrism/clue-benchmark",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "license": "Pending owner decision; no public redistribution license granted",
  "creator": {
    "@type": "sc:Organization",
    "name": "TrustPrism"
  },
  "rai:hasSyntheticData": true,
  "rai:dataLimitations": "Narrow formal mystery domain; full hidden world need not be unique; structural proof routes are not calibrated model difficulty; no paid model evidence.",
  "rai:dataBiases": "Constructed exclusion scaffolds and solver rejection affect clue frequencies. Topic labels and remaining counts convey side information by design.",
  "rai:personalSensitiveInformation": "No human participant data; neutral synthetic suspect IDs.",
  "rai:dataUseCases": "Established: synthetic puzzle correctness, exact murderer scoring, reproducible finite evidence replay. Pending: construct validity for model reasoning, strategic evidence selection across sizes, and generalization beyond controlled templates. Not recommended for real-world criminal investigation, safety assessment, fairness auditing, or ranking general intelligence.",
  "prov:wasDerivedFrom": "https://github.com/TrustPrism/clue-generator",
  "prov:wasGeneratedBy": {
    "@type": "prov:Activity",
    "name": "Seeded paired generation and CP-SAT validation; configs and split design in manifest.json."
  },
